<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <!-- api-design-audit #1: LTS support — dual target net8 (LTS) + net10 -->
    <RootNamespace>EfCore.Interceptors</RootNamespace>
    <AssemblyName>EfCore.Interceptors</AssemblyName>
    <PackageId>EfCore.Interceptors</PackageId>
    <Authors>EfCore.Interceptors contributors</Authors>
    <Description>Production-ready interceptor suite for EF Core 10: auditing, soft deletes, domain events, outbox, multi-tenancy, SQL logging, slow query detection, second-level cache, N+1 detection, query hints, read-only guards, session init, connection/transaction logging, metrics, property encryption and identity resolution.</Description>
    <PackageTags>efcore;efcore10;entity-framework-core;interceptors;audit;audit-trail;soft-delete;outbox;multi-tenant;caching;nplus1;metrics;encryption;governance</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Maxvalpav/EfCoreInterceptors</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Maxvalpav/EfCoreInterceptors</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.19" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EfCore.Interceptors.Analyzers\EfCore.Interceptors.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\EfCore.Interceptors.Analyzers\bin\$(Configuration)\netstandard2.0\EfCore.Interceptors.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" Condition="Exists('..\EfCore.Interceptors.Analyzers\bin\$(Configuration)\netstandard2.0\EfCore.Interceptors.Analyzers.dll')" />
  </ItemGroup>

</Project>

