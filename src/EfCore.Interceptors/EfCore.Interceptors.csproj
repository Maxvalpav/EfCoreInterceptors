<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EfCore.Interceptors</RootNamespace>
    <AssemblyName>EfCore.Interceptors</AssemblyName>
    <PackageId>EfCore.Interceptors</PackageId>
    <Authors>EfCore.Interceptors contributors</Authors>
    <Description>Production-ready interceptor suite for EF Core 10: auditing, soft deletes, domain events, outbox, multi-tenancy, SQL logging, slow query detection, second-level cache, N+1 detection, query hints, read-only guards, session init, connection/transaction logging, metrics, property encryption and identity resolution.</Description>
    <PackageTags>efcore;efcore10;entity-framework-core;interceptors;audit;audit-trail;soft-delete;outbox;multi-tenant;caching;nplus1;metrics;encryption</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Maxvalpav/EfCoreInterceptors</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Maxvalpav/EfCoreInterceptors</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
