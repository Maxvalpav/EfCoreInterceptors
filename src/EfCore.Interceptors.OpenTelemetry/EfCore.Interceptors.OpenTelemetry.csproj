<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <RootNamespace>EfCore.Interceptors.OpenTelemetry</RootNamespace>
    <AssemblyName>EfCore.Interceptors.OpenTelemetry</AssemblyName>
    <PackageId>EfCore.Interceptors.OpenTelemetry</PackageId>
    <Authors>EfCore.Interceptors contributors</Authors>
    <Description>OpenTelemetry wiring for EfCore.Interceptors: registers its ActivitySources with the tracer provider.</Description>
    <PackageTags>efcore;opentelemetry;tracing;interceptors</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Maxvalpav/EfCoreInterceptors</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Maxvalpav/EfCoreInterceptors</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="OpenTelemetry" Version="1.12.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="OpenTelemetry" Version="1.12.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EfCore.Interceptors\EfCore.Interceptors.csproj" />
  </ItemGroup>

</Project>
