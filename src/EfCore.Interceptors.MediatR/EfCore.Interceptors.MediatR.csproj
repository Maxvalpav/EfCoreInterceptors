<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EfCore.Interceptors.MediatR</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>MediatR adapter for EfCore.Interceptors: publish domain events raised by aggregates through the MediatR pipeline.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EfCore.Interceptors\EfCore.Interceptors.csproj" />
    <PackageReference Include="MediatR" Version="12.5.0" />
  </ItemGroup>

</Project>
