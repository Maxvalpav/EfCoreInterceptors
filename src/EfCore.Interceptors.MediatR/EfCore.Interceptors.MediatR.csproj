<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <RootNamespace>EfCore.Interceptors.MediatR</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>MediatR adapter for EfCore.Interceptors: publish domain events raised by aggregates through the MediatR pipeline.</Description>
    <PackageId>EfCore.Interceptors.MediatR</PackageId>
    <Authors>EfCore.Interceptors contributors</Authors>
    <PackageTags>efcore;mediatr;outbox;interceptors</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Maxvalpav/EfCoreInterceptors</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Maxvalpav/EfCoreInterceptors</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EfCore.Interceptors\EfCore.Interceptors.csproj" />
    <PackageReference Include="MediatR" Version="12.5.0" />
  </ItemGroup>

</Project>
