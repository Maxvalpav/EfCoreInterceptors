<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="MassTransit" Version="8.3.0" />
    <PackageReference Include="OpenTelemetry" Version="1.12.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="MediatR" Version="14.2.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.5.0" />
  </ItemGroup>

  <!-- Provider packages are TFM-specific: v10 providers are net10-only (C-1) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EfCore.Interceptors\EfCore.Interceptors.csproj" />
    <ProjectReference Include="..\..\src\EfCore.Interceptors.Generators\EfCore.Interceptors.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\EfCore.Interceptors.Dashboard\EfCore.Interceptors.Dashboard.csproj" />
    <ProjectReference Include="..\..\src\EfCore.Interceptors.HealthChecks\EfCore.Interceptors.HealthChecks.csproj" />
    <ProjectReference Include="..\..\src\EfCore.Interceptors.MassTransit\EfCore.Interceptors.MassTransit.csproj" />
    <ProjectReference Include="..\..\src\EfCore.Interceptors.OpenTelemetry\EfCore.Interceptors.OpenTelemetry.csproj" />
    <ProjectReference Include="..\..\src\EfCore.Interceptors.MediatR\EfCore.Interceptors.MediatR.csproj" />
    <ProjectReference Include="..\..\src\EfCore.Interceptors.Testing\EfCore.Interceptors.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
